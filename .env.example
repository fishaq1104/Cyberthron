# Darb Al Istidama Environment Variables
# Server Port
PORT=5000
NODE_ENV=development

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# JWT Secret for Session & Role-Based Authentication
JWT_SECRET=your_jwt_secret_key_here

# External APIs (Backend Proxy Only - Never expose to Frontend)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
WEATHER_API_KEY=your_weather_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Prototype Demo Mode toggle (true = realistic Abu Dhabi fallbacks when APIs are offline)
DEMO_MODE=true
